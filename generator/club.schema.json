{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "club.schema.json",
  "title": "Club",
  "type": "object",
  "additionalProperties": false,
  "required": ["clubName"],
  "properties": {
    "clubName":    { "type": "string", "minLength": 1 },
    "advisorName": { "type": "string" },
    "description": { "type": "string" },
    "meetingTime": { "type": "string" },
    "siteMode":    { "type": "string", "enum": ["dynamic", "single", "multipage"] },
    "tagline":     { "type": "string" },
    "heroImage":   { "type": "string", "minLength": 1 },
    "moreText":    { "type": "string" },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaryColor":     { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
        "accentColor":      { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
        "accentTextColor":  { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
        "backgroundColor":  { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
        "surfaceColor":     { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
        "textColor":        { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
        "mutedTextColor":   { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
        "borderColor":      { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
        "headingFont":      { "type": "string", "minLength": 1 },
        "bodyFont":         { "type": "string", "minLength": 1 }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url":   { "type": "string", "minLength": 1 },
          "icon":  { "type": "string", "minLength": 1 }
        }
      }
    },
    "officers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "photo": { "type": "string", "minLength": 1 }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "date"],
        "properties": {
          "title":       { "type": "string", "minLength": 1 },
          "date":        { "type": "string", "format": "date" },
          "description": { "type": "string" }
        }
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "year"],
        "properties": {
          "title":       { "type": "string", "minLength": 1 },
          "year":        { "type": "integer", "minimum": 1900, "maximum": 2100 },
          "description": { "type": "string" },
          "featured":    { "type": "boolean" }
        }
      }
    },
    "images": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "heroEyebrow":    { "type": "string" },
    "heroTitleLine1": { "type": "string" },
    "heroTitleLine2": { "type": "string" },
    "heroLead":       { "type": "string" },
    "process": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title":       { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "testimonial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quote":       { "type": "string" },
        "attribution": { "type": "string" }
      }
    },
    "ctaButtons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "footerTagline": { "type": "string" },
    "socialLinks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instagramUrl": { "type": "string" },
        "donateUrl":    { "type": "string" },
        "volunteerUrl": { "type": "string" }
      }
    }
  }
}